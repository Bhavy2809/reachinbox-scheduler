# Loaded with `node --env-file` BEFORE the app's dotenv, so these win over backend/.env.
# Tests use their own database and Redis DB index, never your dev data.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reachinbox_test
REDIS_URL=redis://localhost:6379/15
ELASTICSEARCH_URL=
SMTP_SIMULATE=true
ETHEREAL_ACCOUNTS=sender1@ethereal.email:pass1,sender2@ethereal.email:pass2
MIN_DELAY_BETWEEN_SENDS_MS=50
MAX_EMAILS_PER_HOUR_PER_SENDER=200
WORKER_CONCURRENCY=5
SEND_MAX_ATTEMPTS=3
SEND_LOCK_TTL_MS=60000
JWT_SECRET=test-secret
