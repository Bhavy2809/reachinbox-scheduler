# ---------- Server ----------
PORT=4000
FRONTEND_URL=http://localhost:3000
# Public URL of THIS backend (used to build OAuth redirect URIs)
BACKEND_URL=http://localhost:4000
# Long random string. Signs the session cookie and OAuth state.
JWT_SECRET=change-me-to-a-long-random-string
# Run the BullMQ worker inside the API process (true) or as a separate process via `npm run dev:worker` (false)
RUN_WORKER_IN_API=false

# ---------- PostgreSQL ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reachinbox

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Elasticsearch (optional - falls back to SQL search if unreachable) ----------
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ---------- Worker / throughput ----------
# How many jobs one worker process handles in parallel
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the SAME sender (ms). Mimics provider throttling.
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Hard cap per sender per clock hour, shared across all workers (Redis counter)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Retry attempts for SMTP failures before an email is marked failed
SEND_MAX_ATTEMPTS=3
# If a worker dies mid-send, how long before another worker may take the email over (ms)
SEND_LOCK_TTL_MS=60000

# ---------- Ethereal senders ----------
# Number of Ethereal sender accounts to auto-create on first boot (stored in DB)
SENDER_COUNT=3
# Optional: use fixed Ethereal accounts instead (comma separated user:pass). Get them at https://ethereal.email/create
# ETHEREAL_ACCOUNTS=alice@ethereal.email:pass1,bob@ethereal.email:pass2
# true only on hosts that block outbound SMTP (Railway/Render non-Pro): sends are simulated + labelled in the UI
SMTP_SIMULATE=false
# Optional SMTP override (testing only)
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587

# ---------- Google OAuth ----------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Slack OAuth ----------
# api.slack.com/apps -> Create app -> OAuth & Permissions -> scope: incoming-webhook
# Redirect URL: <BACKEND_URL>/api/slack/callback  (Slack requires HTTPS - use an ngrok/cloudflared URL)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional: override if BACKEND_URL is http://localhost but Slack must reach you via a tunnel
# SLACK_REDIRECT_URI=https://your-tunnel.ngrok-free.app/api/slack/callback
